# Скопируйте в backup.env (chmod 600) и заполните. Файл backup.env в git не коммитится.
APP_ENV_FILE=/opt/sawmill/.env        # .env приложения: оттуда берётся токен бота для уведомлений
BACKUP_DIR=/var/backups/sawmill       # куда складывать копии (вне папки проекта!)
DB_CONTAINER=sawmill_db
DB_USER=postgres
DB_NAME=telegram-mini-app_db

TG_CHAT_ID=                           # ВАШ числовой Telegram ID: сюда придут уведомления
WATCH_URL=https://ВАШ_ДОМЕН/readyz    # адрес для проверки доступности (см. watchdog.sh)

# Хранение на сервере (в днях)
KEEP_DAILY_DAYS=14
KEEP_WEEKLY_DAYS=60
KEEP_MONTHLY_DAYS=400

# Копия вне сервера (хотя бы один вариант, иначе поломка сервера унесёт и бэкапы)
RCLONE_REMOTE=                        # например: b2:sawmill-backups  или  gdrive:sawmill
KEEP_REMOTE_DAYS=30
TG_SEND_FILE=0                        # 1 = присылать шифрованную копию в Telegram (файл до ~45 МБ)
GPG_PASSPHRASE_FILE=/root/.sawmill-backup-pass
